<UserControl x:Class="kniga_book_teliphony.Views.AboutView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:kniga_book_teliphony.Views"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid Background="White" Margin="20">
        <StackPanel>
            <TextBlock Text="{Binding AppName}" FontSize="20"></TextBlock>
            <TextBlock Text="{Binding Version}" FontSize="20"></TextBlock>
        </StackPanel>
    </Grid>
</UserControl>
